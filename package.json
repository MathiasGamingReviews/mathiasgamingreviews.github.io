{
  "name": "mgr-app",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "edit": "node scripts/edit.mjs",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "npm run test:app && npm run test:scripts",
    "test:app": "ng test --watch=false",
    "test:watch": "ng test",
    "test:scripts": "node --test \"scripts/test/*.test.mjs\"",
    "lint": "ng lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check && npm test && npm run build",
    "db:create": "node scripts/create-db.mjs",
    "db:migrate": "node scripts/migrate-db.mjs",
    "db:dump": "node scripts/dump-db.mjs",
    "db:restore": "node scripts/restore-db.mjs"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.2.4",
    "@angular/common": "^22.2.4",
    "@angular/compiler": "^22.2.4",
    "@angular/core": "^22.2.4",
    "@angular/forms": "^22.2.4",
    "@angular/platform-browser": "^22.2.4",
    "@angular/platform-browser-dynamic": "^22.2.4",
    "@angular/router": "^22.2.4",
    "rxjs": "~7.8.0",
    "sql.js": "1.14.2",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular/build": "^22.2.5",
    "@angular/cli": "^22.2.5",
    "@angular/compiler-cli": "^22.2.4",
    "@types/sql.js": "1.4.11",
    "angular-cli-ghpages": "^3.1.2",
    "angular-eslint": "22.6.0",
    "eslint": "^9.28.0",
    "globals": "15.12.0",
    "jsdom": "^30.1.3",
    "prettier": "3.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.33.1",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  }
}
